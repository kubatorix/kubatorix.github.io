        "],"\n          "],"\n        "],"\n\n        ",["SECTION",{"class":"section6 section6__phase7","aria-label":"Section 6 — приглашение к исследованию","style":"--canvas-scale: 0.8611; --section6-progress: 0.0000;"},"\n          ",["DIV",{"class":"section6__viewport"},"\n            ",["DIV",{"class":"section6__canvas"},"\n              ","\n              ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/section6_rings.svg","src":"./img/figma/section6_rings.svg","class":"section6__rings","alt":"","aria-hidden":"true"}],"\n\n              ",["H2",{"class":"section6__heading"},"\n                Это лишь маленькая часть большого\n                ",["SPAN",{"class":"section6__heading-underline"},"исследования"],"\n              "],"\n              ",["A",{"href":"fullstudy.html","class":"section6__cta"},"Посмотреть полный текст"],"\n              ",["SPAN",{"class":"section6__divider","aria-hidden":"true"}],"\n            "],"\n          "],"\n        "],"\n\n        ","\n        ",["DIV",{"class":"phase-gradient-wrap"},"\n          ","\n          ",["SECTION",{"class":"section8 section8__phase8","aria-label":"Section 8 — материалы и события","style":"--canvas-scale: 1.0000;"},"\n            ",["DIV",{"class":"section8__viewport"},"\n              ",["DIV",{"class":"section8__canvas"},"\n                ","\n                ",["DIV",{"class":"s8__intro"},"\n                  ",["H2",{"class":"s8__intro-heading"},"\n                    Чтобы продолжить разговор, мы собрали\n                    ",["SPAN",{"class":"s8__intro-underline"},"опыт"],"\n                  "],"\n                  ",["P",{"class":"s8__intro-body s8__intro-body--desktop"},"\n                    коллег из сектора, экспертов из других индустрий\n                    в текстах,",["BR"],"а ещё подготовили события\n                    по теме. Смотрите, читайте, регистрируйтесь.\n                  "],"\n                  ",["P",{"class":"s8__intro-body s8__intro-body--mobile"},"\n                    Наш спецпроект — это не только само исследование,\n                    но и его обсуждение. Мы собрали опыт коллег\n                    из сектора, узнали мнение экспертов из других\n                    индустрий, организовали события. Смотрите, читайте,\n                    регистрируйтесь.\n                  "],"\n                "],"\n\n                ","\n                ",["DIV",{"class":"s8__track","data-index":"0"},"\n                  ","\n                  ",["ARTICLE",{"class":"s8__card s8__card--event s8__card--pos1","data-active":"true"},"\n                    ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/section8_event_thumb_b.svg","src":"./img/figma/section8_event_thumb_b.svg","class":"s8__media s8__media--svg","alt":""}],"\n                    ",["SPAN",{"class":"s8__pill s8__pill--outline s8__pill--event-left"},"Закрытая встреча"],"\n                    ",["SPAN",{"class":"s8__connector s8__connector--event","aria-hidden":"true"}],"\n                    ",["SPAN",{"class":"s8__pill s8__pill--lime s8__pill--event-right"},"15 мая"],"\n                    ",["P",{"class":"s8__heading"},"\n                      Фандрайзеры очарованные",["BR"],"и разочарованные\n                    "],"\n                  "],"\n\n                  ","\n                  ",["ARTICLE",{"class":"s8__card s8__card--story s8__card--pos2"},"\n                    ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/section8_story_photo.png","src":"./img/figma/section8_story_photo.png","class":"s8__media s8__media--photo","alt":""}],"\n                    ",["SPAN",{"class":"s8__pill s8__pill--outline s8__pill--story-left"},"Про деньги"],"\n                    ",["SPAN",{"class":"s8__connector s8__connector--story","aria-hidden":"true"}],"\n                    ",["SPAN",{"class":"s8__pill s8__pill--white s8__pill--story-right"},"Текст"],"\n                    ",["P",{"class":"s8__heading"},"\n                  