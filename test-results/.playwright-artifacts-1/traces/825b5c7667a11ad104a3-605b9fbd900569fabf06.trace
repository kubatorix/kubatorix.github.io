,"y2":"9.92","stroke":"currentColor","stroke-width":"0.816"}],"\n              ",["line",{"x1":"0","y1":"4.96","x2":"9.92","y2":"4.96","stroke":"currentColor","stroke-width":"0.816"}],"\n            "],"\n          "],"\n          ",["A",{"href":"https://fundr.sredasvoih.com/about/","class":"topnav__link topnav__link--about header_inside-item"},"Об организаторах"],"\n\n          ","\n          ",["DIV",{"class":"topnav__events-popup","id":"topnav-events-popup","role":"menu","aria-hidden":"true"},["A",{"href":"#","class":"topnav__events-item","role":"menuitem"},["SPAN",{"class":"topnav__events-date"},"29 мая"],["SPAN",{"class":"topnav__events-title"},"Урок в Среде. Как найти фандрайзера? Событие с Иваном Сосискиным"]],["A",{"href":"#","class":"topnav__events-item","role":"menuitem"},["SPAN",{"class":"topnav__events-date"},"29 августа"],["SPAN",{"class":"topnav__events-title"},"Урок в Среде. Как найти фандрайзера? Событие с Иваном Сосискиным"]],["A",{"href":"#","class":"topnav__events-item","role":"menuitem"},["SPAN",{"class":"topnav__events-date"},"29 мая"],["SPAN",{"class":"topnav__events-title"},"Урок в Среде. Как найти фандрайзера?"]]],"\n        "],"\n      "],"\n    "],"\n    ",["DIV",{"class":"container-wrapper"},"\n      ",["DIV",{"class":"container-custom"},"\n        ",["DIV",{"class":"container"},"\n          ",["SECTION",{"class":"hero","data-state":"both"},"\n            ",["DIV",{"class":"hero__canvas"},"\n              ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/hero_oval.svg","src":"./img/figma/hero_oval.svg","class":"hero__bg hero__bg--oval","alt":"","aria-hidden":"true"}],"\n              ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/hero_triangle_up.svg","src":"./img/figma/hero_triangle_up.svg","class":"hero__bg hero__bg--triangle-up","alt":"","aria-hidden":"true"}],"\n              ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/hero_arc.svg","src":"./img/figma/hero_arc.svg","class":"hero__bg hero__bg--arc","alt":"","aria-hidden":"true"}],"\n              ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/hero_triangle_down.svg","src":"./img/figma/hero_triangle_down.svg","class":"hero__bg hero__bg--triangle-down","alt":"","aria-hidden":"true"}],"\n\n              ",["DIV",{"class":"hero__brand"},"\n                ",["SPAN",{"class":"hero__brand-word"},"Спецпроект"],"\n                ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/logo_specproject.svg","src":"./img/figma/logo_specproject.svg","alt":"СРЕДА_СВОИХ","class":"hero__brand-logo"}],"\n              "],"\n\n              ",["H1",{"class":"hero__caption"},"\n                ",["SPAN",{"class":"hero__caption-line hero__caption-line--1"},"Исследование"],"\n                ",["SPAN",{"class":"hero__caption-line hero__caption-line--2"},"фандрайзеров"],"\n                ",["SPAN",{"class":"hero__caption-line hero__caption-line--3"},"и их "],"\n                ",["SPAN",{"class":"hero__caption-line hero__caption-line--4"}," нанимателей"],"\n              "],"\n\n              ",["DIV",{"class":"hero__toggle","role":"tablist","aria-label":"Аудитория"},"\n                ",["SPAN",{"class":"hero__toggle-bar","aria-hidden":"true"}],"\n                ",["SPAN",{"class":"hero__toggle-pill","aria-hidden":"true"}],"\n                ",["BUTTON",{"type":"button","class":"hero__toggle-segment hero__toggle-segment--left","role":"tab","data-action":"fundraisers","aria-selected":"false"},"\n                  для",["BR"],"фандрайзеров\n                "],"\n                ",["BUTTON",{"type":"button","class":"hero__toggle-segment hero__toggle-segment--center","role":"tab","data-action":"both","aria-selected":"true"},"\n                  для всех\n                "],"\n                ",["BUTTON",{"type":"button","class":"hero__toggle-segment hero__toggle-segment--right","role":"tab","data-action":"employers","aria-selected":"false"},"\n                  для",["BR"],"нанимателей\n                "],"\n                ",["P",{"class":"hero__toggle-descriptor","data-for":"fundraisers"},"\n                  это проект о том, чем должен заниматься фандрайзер\n                  в вашей конкретной организации, и где его искать\n                "],"\n                ",["P",{"class":"hero__toggle-descriptor","data-for":"employers"},"\n                  это проект о том, что важно учитывать нанимателю\n                  при работе с фандрайзером в вашей конкретной\n                  организации\n                "],"\n              "],"\n            "],"\n          "],"\n        "],"\n      "],"\n    "],"\n\n    ",["DIV",{"class":"container-wrapper"},"\n      ",["DIV",{"class":"container"},"\n        ",["SECTION",{"class":"section1"},"\n          ",["DIV",{"class":"section1__canvas"},"\n            ",["P",{"class":"section1__lead"},"\n              Мы собрали данные о действительной роли фандрайзера,\n              потому что на рынке сложилась тревожная ситуация:\n              специалистов ищут постоянно, но совпадения происходят реже,\n              чем хотелось бы. НКО не находят «своих» людей,\n              а фандрайзеры сталкиваются с размытыми ожиданиями\n              и непрозрачными условиями.\n            "],"\n\n            ",["DIV",{"class":"section1__sreda"},"\n              ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/sreda_logo_2.svg","src":"./img/figma/sreda_logo_2.svg","class":"section1__logo","alt":"Среда своих"}],"\n              ",["P",{"class":"section1__desc"},"\n                — пространство в CITYе для благотворительных проектов\n                и тех, кто их создаёт. Проект Комитета общественных\n                связей и молодёжной политики CITYы\n              "],"\n            "],"\n\n            ",["P",{"class":"section1__bridge"},"\n              Чтобы разобраться в причинах противоречия, мы\n            "],"\n\n            ",["DIV",{"class":"section1__boxes"},"\n              ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/section1_mask_left.svg","src":"./img/figma/section1_mask_left.svg","class":"section1__mask-left","alt":""}],"\n              ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/section1_mask_right.svg","src":"./img/figma/section1_mask_right.svg","class":"section1__bg-arc","alt":""}],"\n              ",["IMG",{"__playwright_current_src__":"http://127.0.0.1:8080/img/figma/section1_boxes_mobile.svg","src":"./img/figma/section1_boxes_mobile.svg","class":"section1__boxes-mobile","alt":"","aria-hidden":"true"}],"\n              ",["H2",{"class":"section1__h-issledovanie"},"Исследование"],"\n              ",["P",{"class":"section1__callout"},"\n                Провели качественное и количественное исследование\n                и анализ рынка\n              "],"\n              ",["H2",{"class":"section1__h-opyt"},"Опыт"],"\n              ",["P",{"class":"section1__opyt-body"},"\n                Cобрали опыт и мнения людей из сектора и внешних\n                экспертов для того, чтобы продолжить разговор\n                в практическом ключе — в текстах и событиях\n              "],"\n            "],"\n\n            ",["SPAN",{"class":"section1__divider","aria-hidden":"true"}],"\n          "],"\n        "],"\n\n        ","\n        ",["SECTION",{"class":"section2"},"\n          ",["P",{"class":"section2_text1"},"\n            Из мнений 232 респондентов из 28 регионов COUNTRY,\n            30 интервью и анализа рынка мы собрали портреты\n          "],"\n\n          ",["CANVAS",{"__playwright_bounding_rect__":"{\"left\":100,\"top\":2198.40625,\"right\":1340,\"bottom\":2649.3125}","id":"canvas","width":"1100","height":"400"}],"\n          ",["DIV",{"class":"controls"},"\n            ",["INPUT",{"__playwright_value_":"0.9","type":"range","id":"slider","min":"0.9","max":"1","step":"0.001","value":"0"}],"\n          "],"\n        "],"\n\n        ","\n        ",["SECTION",{"class":"section3 section3__phase5","data-state":"both"},"\n          ",["DIV",{"class":"section3__canvas"},"\n            ","\n            ",["P",{"class":"section3_text1 s3p5__heading"},"\n              Результаты дали нам возможность увидеть\n              ",["SPAN",{"class":"s3p5__underline-target"},"противоречия"],".\n              Например, в представлении об обязанностях\n              и заработной плате\n            "],"\n\n            ","\n            ",["DIV",{"class":"s3p5__mega"},"\n              ",["SPAN",{"class":"s3p5__mega-num s3p5__mega-num--orange","aria-hidden":"true"},["SPAN",{"class":"s3p5__mega-digits"},"46"],["SPAN",{"class":"s3p5__mega-suffix"},",7%"]],"\n              ",["SPAN",{"class":"s3p5__mega-num s3p5__mega-num--purple","aria-hidden":"true"},["SPAN",{"class":"s3p5__mega-digits"},"71"],["SPAN",{"class":"s3p5__mega-suffix"},",7%"]],"\n              ",["SPAN",{"class":"visually-hidden"},"46,7% и 71,7%"],"\n            "],"\n\n            ","\n            ",["DIV",{"class":"s3p5__minicopy"},"\n              ",["P",{"class":"section3_text2 s3p5__minicopy-purple"},"\n                Фандрайзеров совмещают свою работу с другими задачами\n                в организации.\n              "],"\n              ",["P",{"class":"section3_text3 s3p5__minicopy-orange"},"\n                Нанимателей признают, что фандрайзеры выполняют и другие\n                задачи.\n              "],"\n            "],"\n\n            ","\n            ",["DIV",{"class":"s3p5__toggle s3p5__toggle--top"},"\n              ",["DIV",{"class":"s3p5__toggle-inner"},"\n                ",["BUTTON",{"type":"button","class":"s3p5__seg s3p5__seg--left","data-action":"fundraisers","aria-pressed":"false"},"\n                  ",["SPAN",{"class":"s3p5__seg-label"},"мнение",["BR"],"фандрайзеров"],"\n                "],"\n                ",["BUTTON",{"type":"button","class":"s3p5__seg s3p5__seg--mid","data-action":"both","aria-pressed":"true"},"\n                  ",["SPAN",{"class":"s3p5__seg-pill","aria-hidden":"true"}],"\n                  ",["SPAN",{"class":"s3p5__seg-pill-label"},"оба мнения"],"\n                "],"\n                ",["BUTTON",{"type":"button","class":"s3p5__seg s3p5__seg--right","data-action":"employers","aria-pressed":"false"},"\n                  ",["SPAN",{"class":"s3p5__seg-label"},"мнение",["BR"],"нанимателей"],"\n                "],"\n              "],"\n            "],"\n\n            ","\n            ",["DIV",{"class":"text-container s3p5__outline"},"\n              ",["DIV",{"class":"top-row-stack s3p5__outline-top"},"\n                ",["DIV",{"class":"word word-purple s3p5__outline-word s3p5__outline-word--purple"},"\n                  несоразмерный\n                "],"\n                ",["DIV",{"class":"word word-orange s3p5__outline-word s3p5__outline-word--orange"},"\n                  завышенный\n                "],"\n              "],"\n              ",["DIV",{"class":"bottom-row s3p5__outline-bottom"},"уровень оплаты"],"\n            "],"\n\n            ","\n            ",["DIV",{"class":"section4-wrap s3p5__bodywrap"},"\n              ",["P",{"class":"section4_text1 s3p5__body s3p5__body--purple"},"\n                Фандрайзеры часто оценивают текущий уровень оплаты как\n                несоразмерный сложности и ответственности роли. Большинство\n                фандрайзеров (34,7%) получают от 50 до 100 тысяч\n                рублей в месяц. Однако хотят они другого: в абсолютных\n                значениях уровень оплаты труда, который больше половины\n                фандрайзеров (61,4%) оценивают как «приемлемый», соответствует\n                доходу 100 000 рублей в месяц.\n              "],"\n              ",["P",{"class":"section4_text2 s3p5__body s3p5__body--orange"},"\n                Наниматели часто считают ожидания фандрайзеров\n                по фиксированной части оплаты завышенными. Больше трети\n                организаций (38%) ориентируются на волонтёрский формат или\n                исключительно переменную модель оплаты (например, процент\n                от привлеченных средств), а премии\n                за перевыполнение плана встречаются только у 3,4%. 85%\n                опрошенных нанимателей утверждают, что применяют нематериальную\n                мотивацию для своих фандрайзеров.\n              "],"\n            "],"\n\n            ","\n            ",["DIV",{"class":"s3p5__toggle s3p5__toggle--bottom"},"\n              ",["DIV",{"class":"s3p5__toggle-inner"},"\n                ",["BUTTON",{"type":"button","class":"s3p5__seg s3p5__seg--left","data-action":"fundraisers","aria-pressed":"false"},"\n                  ",["SPAN",{"class":"s3p5__seg-label"},"мнение",["BR"],"фандрайзеров"],"\n                "],"\n                ",["BUTTON",{"type":"button","class":"s3p5__seg s3p5__seg--mid","data-action":"both","aria-pressed":"true"},"\n                  ",["SPAN",{"class":"s3p5__seg-pill","aria-hidden":"true"}],"\n                  ",["SPAN",{"class":"s3p5__seg-pill-label"},"оба мнения"],"\n                "],"\n                ",["BUTTON",{"type":"button","class":"s3p5__seg s3p5__seg--right","data-action":"employers","aria-pressed":"false"},"\n                  ",["SPAN",{"class":"s3p5__seg-label"},"мнение",["BR"],"нанимателей"],"\n                "],"\n              "],"\n            "],"\n          "],"\n        "],"\n\n        ","\n        ",["SECTION",{"class":"section4 section4__phase5-empty","aria-hidden":"true"}],"\n\n        ",["SECTION",{"class":"section5 section5__phase6","data-state":"initial","aria-label":"Section 5 — общий взгляд","style":"--canvas-scale: 0.9281; --phase6-progress: 0.0000;"},"\n          ",["DIV",{"class":"section5__viewport"},"\n            ",["DIV",{"class":"section5__canvas"},"\n              ",["H2",{"class":"section5__heading"},"\n                А в некоторых вопросах — заметить\n                ",["SPAN",{"class":"section5__heading-mark"},"совпадение"],"\n                и собрать цельную картину\n              "],"\n              ",["SPAN",{"class":"section5__heading-underline","aria-hidden":"true"}],"\n\n              ","\n              ",["DIV",{"class":"section5__poly section5__poly--left","aria-label":"мнение нанимателей"},"\n                ","\n                ",["svg",{"class":"section5__poly-shape section5__poly-shape--mobile","viewBox":"0 0 340 256","preserveAspectRatio":"none","fill":"none","xmlns":"http://www.w3.org/2000/svg","aria-hidden":"true"},"\n                  ",["path",{"class":"section5__poly-fill","d":"M2 2 L338 2 L338 148 L171 148 L171 254 L2 254 Z","fill":"#FF6E32"}],"\n                  ",["mask",{"id":"mask_p6_orange_mobile","maskUnits":"userSpaceOnUse","x":"0","y":"0","width":"340","height":"256"},"\n                    ",["path",{"d":"M2 2 L338 2 L338 148 L171 148 L171 254 L2 254 Z","fill":"#FFFFFF"}],"\n                  "],"\n                  ",["g",{"mask":"url(#mask_p6_orange_mobile)"},"\n                    ",["path",{"d":"M299.301 127.393C328.486 178.717 340.547 233.576 336.476 280.767C332.405 327.961 312.21 367.437 276.935 388.115C241.659 408.793 197.891 406.812 155.601 386.795C113.313 366.778 72.5512 328.744 43.3659 277.42C14.1807 226.095 2.1196 171.236 6.1904 124.044C10.2614 76.85 30.4557 37.375 65.7313 16.697C101.007 -3.982 144.775 -2.001 187.065 18.017C229.353 38.033 270.115 76.068 299.301 127.393Z","stroke":"white","fill":"none"}],"\n                  "],"\n                  ",["path",{"d":"M2 2 L338 2 L338 148 L171 148 L171 254 L2 254 Z","stroke":"#FF6E32","stroke-width":"2"}],"\n                "],"\n                ",["svg",{"class":"section5__poly-shape section5__poly-shape--desktop","width":"547","height":"412","viewBox":"0 0 547 412","preserveAspectRatio":"none","fill":"none","xmlns":"http://www.w3.org/2000/svg","aria-hidden":"true"},"\n                  ",["path",{"class":"section5__poly-fill","d":"M0.999948 3.3282C0.999998 2.04224 2.04293 1.0003 3.32893 1.00029L542.785 0.999311C544.071 0.999311 545.113 2.0423 54